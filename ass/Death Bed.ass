Dialogue: 0,0:00:00.32,0:00:03.60,ES - Grey,,0,0,0,,No estés lejos por mucho tiempo
Dialogue: 0,0:00:03.60,0:00:05.94,ES - Grey,,0,0,0,,No vayas a la cama
Dialogue: 0,0:00:05.94,0:00:09.08,ES - Grey,,0,0,0,,Haré una taza de café para tu cabeza
Dialogue: 0,0:00:09.08,0:00:12.38,ES - Grey,,0,0,0,,Te levantaré y saldrás de la cama
Dialogue: 0,0:00:13.24,0:00:14.86,ES,,0,0,0,,No quiero quedarme dormido
Dialogue: 0,0:00:14.86,0:00:16.48,ES,,0,0,0,,No quiero fallecer
Dialogue: 0,0:00:16.48,0:00:19.86,ES,,0,0,0,,He estado pensando en nuestro futuro porque nunca veré esos días
Dialogue: 0,0:00:19.86,0:00:21.50,ES,,0,0,0,,No sé por qué ésto ha pasado
Dialogue: 0,0:00:21.50,0:00:23.40,ES,,0,0,0,,Pero probablemente me lo merezco
Dialogue: 0,0:00:23.40,0:00:24.90,ES,,0,0,0,,Intenté dar lo mejor de mí
Dialogue: 0,0:00:24.90,0:00:26.56,ES,,0,0,0,,Pero sabes que no soy perfecto
Dialogue: 0,0:00:26.56,0:00:28.22,ES,,0,0,0,,He estado rezando por perdon
Dialogue: 0,0:00:28.22,0:00:30.14,ES,,0,0,0,,Has estado rezando por mi salud
Dialogue: 0,0:00:30.30,0:00:31.44,ES,,0,0,0,,Cuando deje esta tierra
Dialogue: 0,0:00:31.44,0:00:33.22,ES,,0,0,0,,Espero que encuentres a alguien más
Dialogue: 0,0:00:33.22,0:00:36.54,ES,,0,0,0,,Porque sí, todavía somos muy jóvenes, hay tanto que no hemos hecho
Dialogue: 0,0:00:36.54,0:00:38.24,ES,,0,0,0,,Casarse, formar una familia
Dialogue: 0,0:00:38.24,0:00:39.78,ES,,0,0,0,,que mires a tu esposo con su hijo
Dialogue: 0,0:00:39.78,0:00:41.32,ES,,0,0,0,,Desearía poder ser yo
Dialogue: 0,0:00:41.32,0:00:43.24,ES,,0,0,0,,Pero no puedo dejar ésta cama
Dialogue: 0,0:00:43.36,0:00:44.80,ES,,0,0,0,,Espero ir al cielo
Dialogue: 0,0:00:44.80,0:00:46.54,ES,,0,0,0,,Y así verte otra vez
Dialogue: 0,0:00:46.72,0:00:48.16,ES,,0,0,0,,Mi vida fue un poco corta
Dialogue: 0,0:00:48.16,0:00:50.16,ES,,0,0,0,,Pero tengo tantas bendiciones
Dialogue: 0,0:00:50.16,0:00:51.60,ES,,0,0,0,,Feliz de que fueras mía
Dialogue: 0,0:00:51.78,0:00:53.60,ES,,0,0,0,,Apesta que todo ésto termine
Dialogue: 0,0:00:53.60,0:00:56.90,ES,,0,0,0,,No estés lejos por mucho tiempo
Dialogue: 0,0:00:56.90,0:00:58.98,ES,,0,0,0,,No vayas a la cama
Dialogue: 0,0:00:59.20,0:01:02.32,ES,,0,0,0,,Haré una taza de café para tu cabeza
Dialogue: 0,0:01:02.68,0:01:05.50,ES,,0,0,0,,Te levantaré y saldrás de la cama
Dialogue: 0,0:01:05.50,0:01:06.90,ES,,0,0,0,,Y yo...
Dialogue: 0,0:01:06.90,0:01:10.30,ES - Grey,,0,0,0,,No estés lejos por mucho tiempo
Dialogue: 0,0:01:10.30,0:01:12.30,ES - Grey,,0,0,0,,No vayas a la cama
Dialogue: 0,0:01:12.60,0:01:15.66,ES - Grey,,0,0,0,,Haré una taza de café para tu cabeza
Dialogue: 0,0:01:15.96,0:01:19.04,ES - Grey,,0,0,0,,Te levantaré y saldrás de la cama
Dialogue: 0,0:01:20.08,0:01:21.76,ES,,0,0,0,,Estoy feliz de que estés aquí conmigo
Dialogue: 0,0:01:21.76,0:01:23.42,ES,,0,0,0,,Lo siento si lloro
Dialogue: 0,0:01:23.42,0:01:24.90,ES,,0,0,0,,Cuando tú y yo éramos más jóvenes
Dialogue: 0,0:01:24.90,0:01:26.78,ES,,0,0,0,,Siempre me animabas
Dialogue: 0,0:01:26.92,0:01:28.42,ES,,0,0,0,,Tomando videos tontos
Dialogue: 0,0:01:28.42,0:01:29.92,ES,,0,0,0,,Mientras caminamos por el parque
Dialogue: 0,0:01:29.92,0:01:31.56,ES,,0,0,0,,Saltarías a mis brazos
Dialogue: 0,0:01:31.56,0:01:33.24,ES,,0,0,0,,Cada vez que escuches un ladrido
Dialogue: 0,0:01:33.54,0:01:35.20,ES,,0,0,0,,Acurrucarnos en tus sábanas
Dialogue: 0,0:01:35.20,0:01:36.74,ES,,0,0,0,,Me cantaste hasta dormir
Dialogue: 0,0:01:36.74,0:01:40.08,ES,,0,0,0,,Y escabullirme por tu cocina exactamente a la 1:03
Dialogue: 0,0:01:40.18,0:01:41.78,ES,,0,0,0,,Los domingos ibamos a la iglesia
Dialogue: 0,0:01:41.78,0:01:43.50,ES,,0,0,0,,Los lunes veíamos una película
Dialogue: 0,0:01:43.50,0:01:44.76,ES,,0,0,0,,Pronto estarás sola
Dialogue: 0,0:01:44.76,0:01:46.96,ES,,0,0,0,,Siento que tengas que perderme
Dialogue: 0,0:01:46.96,0:01:50.28,ES,,0,0,0,,No estés lejos por mucho tiempo
Dialogue: 0,0:01:50.28,0:01:52.34,ES,,0,0,0,,No vayas a la cama
Dialogue: 0,0:01:52.64,0:01:55.68,ES,,0,0,0,,Haré una taza de café para tu cabeza
Dialogue: 0,0:01:55.96,0:01:59.42,ES,,0,0,0,,Te levantaré y saldrás de la cama
