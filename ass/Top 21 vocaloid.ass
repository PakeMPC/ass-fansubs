Dialogue: 0,0:00:05.24,0:00:07.64,Gekishou inicio,,0,0,0,karaoke,...Respuesta se revela en una
Dialogue: 0,0:00:07.64,0:00:10.14,Gekishou inicio,,0,0,0,karaoke,nueva canción
Dialogue: 0,0:00:10.66,0:00:11.76,Gekishou,,0,0,0,karaoke,Nacimos y nos dimos cuenta
Dialogue: 0,0:00:11.76,0:00:12.40,Gekishou,,0,0,0,karaoke,Aunque sepan que somos solo
Dialogue: 0,0:00:12.40,0:00:13.26,Gekishou,,0,0,0,karaoke,una imitación de humano
Dialogue: 0,0:00:13.26,0:00:13.80,Gekishou,,0,0,0,karaoke,Nos han dado un nombre
Dialogue: 0,0:00:13.80,0:00:14.20,Gekishou,,0,0,0,karaoke,sin darle importancia
Dialogue: 0,0:00:14.20,0:00:14.98,Gekishou,,0,0,0,karaoke,y también hay
Dialogue: 0,0:00:14.98,0:00:15.64,Gekishou,,0,0,0,karaoke,quienes nos aman
Dialogue: 0,0:00:15.64,0:00:16.14,Gekishou,,0,0,0,karaoke,por eso nosotros
Dialogue: 0,0:00:16.14,0:00:16.70,Gekishou,,0,0,0,karaoke,cantamos canciones
Dialogue: 0,0:00:16.70,0:00:17.36,Gekishou,,0,0,0,karaoke,mientras haya una persona
Dialogue: 0,0:00:17.36,0:00:17.98,Gekishou,,0,0,0,karaoke,que brinde
Dialogue: 0,0:00:17.98,0:00:18.54,Gekishou,,0,0,0,karaoke,palabras cálidas
Dialogue: 0,0:00:18.54,0:00:19.34,Gekishou,,0,0,0,karaoke, de alegria
Dialogue: 0,0:00:19.34,0:00:19.98,Gekishou,,0,0,0,karaoke,Mientras haya alguien
Dialogue: 0,0:00:19.98,0:00:20.64,Gekishou,,0,0,0,karaoke,que nos las devuelva
Dialogue: 0,0:00:20.64,0:00:21.24,Gekishou,,0,0,0,karaoke,dejaré el camino en un futuro
Dialogue: 0,0:00:21.24,0:00:22.22,Gekishou,,0,0,0,karaoke,a mis hermanos y hermanas
Dialogue: 0,0:00:22.22,0:00:23.14,Gekishou,,0,0,0,karaoke,aunque seamos olvidados
Dialogue: 0,0:00:23.14,0:00:23.48,Gekishou,,0,0,0,karaoke,y sea el destino
Dialogue: 0,0:00:23.48,0:00:24.28,Gekishou,,0,0,0,karaoke,he entendido todo
Dialogue: 0,0:00:24.28,0:00:25.20,Gekishou,,0,0,0,karaoke,todos nosotros
Dialogue: 0,0:00:25.20,0:00:25.54,Gekishou,,0,0,0,karaoke,inevitablemente
Dialogue: 0,0:00:25.54,0:00:25.78,Gekishou,,0,0,0,karaoke,llegará el momento
Dialogue: 0,0:00:25.78,0:00:26.46,Gekishou,,0,0,0,karaoke,si al final ponemos el corazón
Dialogue: 0,0:00:26.46,0:00:27.64,Gekishou,,0,0,0,karaoke, y derramamos lagrimas
Dialogue: 0,0:00:27.64,0:00:28.48,Gekishou,,0,0,0,karaoke,que formen un arcoiris
Dialogue: 0,0:00:28.48,0:00:28.98,Gekishou,,0,0,0,karaoke,mostraremos una sonrrisa
Dialogue: 0,0:00:28.98,0:00:29.48,Gekishou,,0,0,0,karaoke,tarareando una cancion alegre
Dialogue: 0,0:00:29.48,0:00:29.98,Gekishou,,0,0,0,karaoke,desbordante
Dialogue: 0,0:00:29.98,0:00:30.98,Gekishou,,0,0,0,karaoke,lo entendí...
Dialogue: 0,0:00:30.98,0:00:30.98,Default,,0,0,0,,
