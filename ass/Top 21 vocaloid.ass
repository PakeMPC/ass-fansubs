Comment: 0,0:02:28.67,0:02:28.93,Default,,0,0,0,code once,function random_color_spectrum()    local r, g, b    repeat        r = math.random(0, 255)        g = math.random(0, 255)         b = math.random(0, 255)    until not ((r < 20 and g < 20 and b < 20) or               (r > 235 and g > 235 and b > 235) or             (math.abs(r-g) < 30 and math.abs(g-b) < 30 and math.abs(r-b) < 30))       return string.format("%02X%02X%02X", b, g, r) end
