Dialogue: 0,0:07:10.30,0:07:10.94,Just Be,,0,0,0,,sin voz
Dialogue: 0,0:07:10.94,0:07:13.43,Just Be,,0,0,0,,me quedé de tanto gritarlo
Dialogue: 0,0:07:13.43,0:07:14.47,Just Be,,0,0,0,,hubo eco
Dialogue: 0,0:07:14.47,0:07:15.38,Just Be,,0,0,0,,reverberación
Dialogue: 0,0:07:15.38,0:07:17.69,Just Be,,0,0,0,,un resonar vacío
Dialogue: 0,0:07:17.69,0:07:20.01,Just Be,,0,0,0,,se ha roto lo que nos unía
Dialogue: 0,0:07:20.01,0:07:21.42,Just Be,,0,0,0,,ya no queda nada
Dialogue: 0,0:07:21.42,0:07:23.63,Just Be,,0,0,0,,ni una mínima cosa
Dialogue: 0,0:07:23.63,0:07:25.17,Just Be,,0,0,0,,no queda nada
Dialogue: 0,0:07:25.17,0:07:28.56,Just Be,,0,0,0,,esa conexión que nos unió
Dialogue: 0,0:07:28.56,0:07:29.50,Just Be,,0,0,0,,se oscurece
Dialogue: 0,0:07:29.50,0:07:30.42,Just Be,,0,0,0,,se corta
Dialogue: 0,0:07:30.42,0:07:32.64,Just Be,,0,0,0,,se fragilizó, se hizo pedazos
Dialogue: 0,0:07:32.64,0:07:35.05,Just Be,,0,0,0,,al final... es lo que hay
Dialogue: 0,0:07:35.05,0:07:36.43,Just Be,,0,0,0,,susurré
Dialogue: 0,0:07:36.43,0:07:38.83,Just Be,,0,0,0,,por una mejilla triste caía
Dialogue: 0,0:07:38.83,0:07:43.07,Just Be,,0,0,0,,la lágrima de alguien
Dialogue: 0,0:07:44.24,0:07:45.34,Just Be 2,,0,0,0,,ser solo amigos
Dialogue: 0,0:07:46.14,0:07:48.01,Just Be 2,,0,0,0,,es hora de decir adios
Dialogue: 0,0:07:47.98,0:07:49.19,Just Be 2,,0,0,0,,ser solo amigos
